1. 네이버 API 미설정 안내 추가

파일: server/routes/analyze.js

변경 전:

async function fetchNaverPrice(productName, partType) {
  const id     = process.env.NAVER_CLIENT_ID
  const secret = process.env.NAVER_CLIENT_SECRET
  if (!id || !secret) return null

네이버 API 키가 없으면 null만 반환했습니다.
그래서 가격 조회가 실패해도 사용자에게 별도 안내가 없었습니다.

변경 후:

function hasNaverPriceConfig() {
  return Boolean(process.env.NAVER_CLIENT_ID && process.env.NAVER_CLIENT_SECRET)
}

if (analysisResult.upgrades?.length) {
